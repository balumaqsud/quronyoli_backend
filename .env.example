# Application
# Checklist aliases (do not rename in code):
#   JWT_SECRET          -> JWT_ACCESS_SECRET (+ JWT_REFRESH_SECRET)
#   BOT_TOKEN           -> TELEGRAM_BOT_TOKEN
#   QURAN_API_KEY       -> QF_CLIENT_ID + QF_CLIENT_SECRET (OAuth)
NODE_ENV=development
PORT=3000
APP_NAME=quron-yoli-backend
API_PREFIX=api
API_VERSION=1
LOG_DIR=logs
UPLOADS_DIR=uploads
# Public HTTPS origin (no trailing slash). Used for Classic Medina 1405 image URLs
# when QF_MUSHAF_1405_IMAGE_BASE is empty. deploy.sh / update.sh auto-fill this
# from DOMAIN or TELEGRAM_WEBHOOK_URL when 604 WebPs exist under uploads/mushaf/1405/.
PUBLIC_API_ORIGIN=https://your-api-host

# CORS (comma-separated origins)
# Include https://web.telegram.org and your deployed Mini App origin (e.g. Vercel).
CORS_ORIGINS=http://localhost:3000,https://web.telegram.org,https://quronyoli-front.vercel.app

# PostgreSQL
# Local Node process: use localhost. Docker Compose overrides DATABASE_URL to host "postgres".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quron_yoli?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quron_yoli
POSTGRES_PORT=5432

# Redis
# Local Node process: use localhost. Docker Compose overrides REDIS_HOST to "redis".
# Production Compose requires a non-empty REDIS_PASSWORD.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
REDIS_KEY_PREFIX=quron-yoli:

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# Telegram Bot + Mini App
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=QuronYoliBot
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=15000
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret-min-16
TELEGRAM_WEBHOOK_AUTO_REGISTER=false
TELEGRAM_WEBHOOK_DROP_PENDING_UPDATES=false
TELEGRAM_MINI_APP_URL=https://t.me/QuronYoliBot/app
TELEGRAM_WEB_APP_URL=https://quronyoli-front.vercel.app
TELEGRAM_MINI_APP_SHORT_NAME=app
TELEGRAM_HTTP_MAX_SOCKETS=50

# Notifications / BullMQ
NOTIFICATIONS_QUEUE_NAME=daily-reminders
NOTIFICATIONS_QUEUE_CONCURRENCY=5
NOTIFICATIONS_REMINDER_SCAN_CRON=* * * * *
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_BACKOFF_DELAY_MS=5000

# Analytics
ANALYTICS_MAX_BATCH_SIZE=100
ANALYTICS_MAX_CLOCK_SKEW_SECONDS=300
ANALYTICS_DB_CHUNK_SIZE=100
ANALYTICS_BUFFER_TTL_SECONDS=3600
ANALYTICS_FLUSH_DELAY_MS=2000
ANALYTICS_FLUSH_MAX_BATCH=500
ANALYTICS_QUEUE_NAME=analytics-flush
ANALYTICS_MAX_ATTEMPTS=5
ANALYTICS_BACKOFF_DELAY_MS=5000
ANALYTICS_MAX_PROPERTIES_BYTES=4096
ANALYTICS_STATS_CACHE_TTL_SECONDS=30

# Reading
READING_STREAK_LOOKBACK_DAYS=400

# HTTP / production hardening
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_BODY_LIMIT=1mb
TRUST_PROXY=false
SLOW_REQUEST_MS=1000
SHUTDOWN_DRAIN_MS=5000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=20

# Auth refresh cookie
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Defaults to true when AUTH_COOKIE_SAME_SITE=none (CHIPS for cross-site Mini App)
# AUTH_COOKIE_PARTITIONED=true

# Quran.Foundation (Content + Search proxy)
QF_CLIENT_ID=replace-with-qf-client-id
QF_CLIENT_SECRET=replace-with-qf-client-secret
QF_ENV=production
# Optional overrides:
# QF_AUTH_BASE_URL=https://oauth2.quran.foundation
# QF_API_BASE_URL=https://apis.quran.foundation
QF_CONTENT_PATH_PREFIX=/content/api/v4
QF_SEARCH_PATH_PREFIX=/search/v1
QF_CONTENT_SCOPE=content
QF_SEARCH_SCOPE=search
QF_TIMEOUT_MS=30000
QF_MAX_RETRIES=3
QF_RETRY_BASE_DELAY_MS=250
QF_TOKEN_SKEW_SECONDS=30
QF_RATE_LIMIT_MAX=60
QF_RATE_LIMIT_WINDOW_SECONDS=60
QF_HTTP_MAX_SOCKETS=50
# Absolute base for relative ayah audio paths (e.g. Alafasy/mp3/001001.mp3)
QF_AUDIO_CDN_BASE=https://audio.qurancdn.com
# Mushaf 10 (Dar al-Marefa) full-page WebP CDN
QF_TAJWEED_PAGE_IMAGE_BASE=https://www.noureddin.dev/quran-pages/2/pages/776x1053-webp
QF_TAJWEED_PAGE_IMAGE_EXT=webp
# Mushaf 1405 (classic Medina) — auto-filled by deploy/update when 604 WebPs
# exist under uploads/mushaf/1405/ (or set manually to match PUBLIC_API_ORIGIN).
QF_MUSHAF_1405_IMAGE_BASE=https://your-api-host/uploads/mushaf/1405
QF_MUSHAF_1405_IMAGE_EXT=webp
QF_CACHE_TTL_CHAPTERS_SECONDS=86400
QF_CACHE_TTL_VERSES_SECONDS=3600
QF_CACHE_TTL_RESOURCES_SECONDS=86400
QF_CACHE_TTL_SEARCH_SECONDS=300
QF_CACHE_TTL_AUDIO_SECONDS=3600

# Logging
LOG_LEVEL=info

# Swagger (defaults to false in production when unset)
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# First SUPER_ADMIN bootstrap (used by prisma seed)
SUPER_ADMIN_TELEGRAM_ID=
SUPER_ADMIN_USERNAME=

# Dev tooling (docker compose --profile dev)
PGADMIN_DEFAULT_EMAIL=admin@quron-yoli.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
REDIS_INSIGHT_PORT=5540
