# Application
NODE_ENV=development
PORT=3000
APP_NAME=quron-yoli-backend
API_PREFIX=api
API_VERSION=1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://web.telegram.org

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quron_yoli?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quron_yoli
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=quron-yoli:

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# Telegram Mini App
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# Auth refresh cookie
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Logging
LOG_LEVEL=info

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
