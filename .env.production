# Production template — copy and fill secrets:
#   cp .env.production .env
# Then: docker compose -f docker-compose.yml up -d --build
#
# Docker Compose overrides DATABASE_URL / REDIS_HOST to internal service DNS.
# Do not expose Postgres or Redis ports on the host in production.

NODE_ENV=production
PORT=3000
APP_NAME=quron-yoli-backend
API_PREFIX=api
API_VERSION=1
LOG_DIR=/app/logs
UPLOADS_DIR=/app/uploads

# Comma-separated Mini App + Telegram Web origins
CORS_ORIGINS=https://web.telegram.org,https://REPLACE_WITH_MINI_APP_ORIGIN

DATABASE_URL=postgresql://REPLACE_POSTGRES_USER:REPLACE_POSTGRES_PASSWORD@postgres:5432/quron_yoli?schema=public
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
POSTGRES_USER=REPLACE_POSTGRES_USER
POSTGRES_PASSWORD=REPLACE_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=quron_yoli

# Required in production (Compose fails without it)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_STRONG_REDIS_PASSWORD
REDIS_DB=0
REDIS_KEY_PREFIX=quron-yoli:

JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=REPLACE_BOT_USERNAME
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=15000
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
TELEGRAM_WEBHOOK_URL=https://REPLACE_PUBLIC_API_HOST/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=REPLACE_WEBHOOK_SECRET_MIN_16
TELEGRAM_WEBHOOK_AUTO_REGISTER=true
TELEGRAM_MINI_APP_URL=https://t.me/REPLACE_BOT_USERNAME/app
TELEGRAM_WEB_APP_URL=https://REPLACE_WITH_MINI_APP_ORIGIN
TELEGRAM_MINI_APP_SHORT_NAME=app
TELEGRAM_HTTP_MAX_SOCKETS=50

NOTIFICATIONS_QUEUE_NAME=daily-reminders
NOTIFICATIONS_QUEUE_CONCURRENCY=5
NOTIFICATIONS_REMINDER_SCAN_CRON=* * * * *
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_BACKOFF_DELAY_MS=5000

ANALYTICS_MAX_BATCH_SIZE=100
ANALYTICS_MAX_CLOCK_SKEW_SECONDS=300
ANALYTICS_DB_CHUNK_SIZE=100
ANALYTICS_BUFFER_TTL_SECONDS=3600
ANALYTICS_FLUSH_DELAY_MS=2000
ANALYTICS_FLUSH_MAX_BATCH=500
ANALYTICS_QUEUE_NAME=analytics-flush
ANALYTICS_MAX_ATTEMPTS=5
ANALYTICS_BACKOFF_DELAY_MS=5000
ANALYTICS_MAX_PROPERTIES_BYTES=4096
ANALYTICS_STATS_CACHE_TTL_SECONDS=30

READING_STREAK_LOOKBACK_DAYS=400

HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_BODY_LIMIT=1mb
TRUST_PROXY=true
SLOW_REQUEST_MS=1000
SHUTDOWN_DRAIN_MS=5000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=20

AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=none
AUTH_COOKIE_PARTITIONED=true

QF_CLIENT_ID=REPLACE_QF_CLIENT_ID
QF_CLIENT_SECRET=REPLACE_QF_CLIENT_SECRET
QF_ENV=production
QF_CONTENT_PATH_PREFIX=/content/api/v4
QF_SEARCH_PATH_PREFIX=/search/v1
QF_CONTENT_SCOPE=content
QF_SEARCH_SCOPE=search
QF_TIMEOUT_MS=30000
QF_MAX_RETRIES=3
QF_RETRY_BASE_DELAY_MS=250
QF_TOKEN_SKEW_SECONDS=30
QF_RATE_LIMIT_MAX=60
QF_RATE_LIMIT_WINDOW_SECONDS=60
QF_HTTP_MAX_SOCKETS=50
QF_AUDIO_CDN_BASE=https://audio.qurancdn.com
QF_CACHE_TTL_CHAPTERS_SECONDS=86400
QF_CACHE_TTL_VERSES_SECONDS=3600
QF_CACHE_TTL_RESOURCES_SECONDS=86400
QF_CACHE_TTL_SEARCH_SECONDS=300
QF_CACHE_TTL_AUDIO_SECONDS=3600

LOG_LEVEL=info
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
